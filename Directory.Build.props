<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Company>Nodal</Company>
    <Product>Nodal AcadMcp</Product>
    <Authors>Ed Foster</Authors>
    <Version>0.3.0</Version>
    <Copyright>Copyright © 2026 Ed Foster</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- AutoCAD version -> AutoCAD.NET package + target framework.
       2027 = R26.0, .NET 10. 2020 = R23.1, .NET Framework 4.8 (the add-in runs in-process,
       so it must match the CLR AutoCAD itself hosts). -->
  <PropertyGroup>
    <AcadVersion Condition="'$(AcadVersion)' == ''">2020</AcadVersion>
    <AcadNetPackageVersion Condition="'$(AcadVersion)' == '2020'">23.1.0</AcadNetPackageVersion>
    <AcadNetPackageVersion Condition="'$(AcadVersion)' == '2027'">26.0.0</AcadNetPackageVersion>
    <AcadTargetFramework Condition="'$(AcadVersion)' == '2020'">net48</AcadTargetFramework>
    <AcadTargetFramework Condition="'$(AcadVersion)' == '2027'">net10.0-windows</AcadTargetFramework>
    <AcadInstallDir Condition="'$(AcadInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD $(AcadVersion)</AcadInstallDir>
    <AcadAcaDir>$(AcadInstallDir)\ACA</AcadAcaDir>
  </PropertyGroup>

  <!-- Fail loudly rather than silently resolving the wrong AutoCAD.NET package: an unmapped
       AcadVersion would otherwise fall through to an empty version string. -->
  <Target Name="ValidateAcadVersion" BeforeTargets="PrepareForBuild"
          Condition="'$(AcadNetPackageVersion)' == '' and '$(MSBuildProjectName)' == 'Nodal.AcadMcp.Addin'">
    <Error Text="AcadVersion '$(AcadVersion)' has no AutoCAD.NET package mapping. Supported today: 2020, 2027; see Directory.Build.props." />
  </Target>
</Project>
